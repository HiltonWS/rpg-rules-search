[Unit]
Description=Arquivo Arcano
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=simple
WorkingDirectory=APP_DIRECTORY
Environment=RPG_RULES_HOST=0.0.0.0
Environment=RPG_RULES_PORT=8765
Environment=RPG_RULES_RELOAD=0
Environment=RPG_RULES_OLLAMA_URL=http://127.0.0.1:11434
Environment=RPG_RULES_OLLAMA_MODEL=gemma3:1b
Environment=RPG_RULES_OLLAMA_AUTO_PULL=0
User=YOUR_USERNAME
Group=YOUR_USERNAME
ExecStart=APP_DIRECTORY/.venv/bin/python -m rpg_rules_search
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
